// Стекло: одно и то же искажение по всей карточке, без отдельной оптики края.
//
// Прежние версии считали кромку особо: SDF формы → профиль высоты фаски →
// нормаль → refract(). Физически это верно, но выглядело плохо ровно там, где
// заметнее всего. У грани нормаль встаёт почти горизонтально, преломление
// уводит выборку на десятки точек — дальше, чем вообще снят фон, — и по
// периметру шла размазанная полоса с радужной каймой, отдельная от того
// спокойного искажения, которое даёт стекло в середине.
//
// Поэтому края больше не обрабатываются отдельно. Работает только микрорельеф
// отливки: он одинаков в любой точке карточки, поэтому и картинка ведёт себя
// одинаково от середины до самой грани. От края остаётся лишь тонкая световая
// нить — это контур панели, а не искажение.
//
// Сборка: fxc /T ps_3_0 /E main /Fo glass.ps glass.fx  (результат коммитится).

sampler2D blurred : register(s0);   // вход эффекта: фон под размытием
sampler2D noise   : register(s1);   // микрорельеф отливки
sampler2D sharp   : register(s2);   // тот же фон без размытия

float  Amount  : register(c0);   // сила искажения, 0..0.2
float  Phase   : register(c1);   // дрейф микрорельефа
float2 Area    : register(c2);   // ВСЯ область эффекта в точках: карточка + запас
float  Radius  : register(c3);   // радиус скругления карточки, точки
float2 Pointer : register(c5);   // курсор в точках от центра карточки
float  Touch   : register(c6);   // 0..1 — выпуклость под курсором
float2 Card    : register(c7);   // сама карточка в точках

// Расхождение каналов. Маленькое намеренно: заметно как тончайшая цветная
// кайма на контрастных переходах, больше — как радуга, что читается дефектом.
static const float DISP = 0.02;

/// Знаковое расстояние до края скруглённого прямоугольника: <0 внутри.
float sdRoundRect(float2 p, float2 halfSize, float r)
{
    float2 q = abs(p) - (halfSize - r);
    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}

float3 saturateColor(float3 c, float k)
{
    float l = dot(c, float3(0.2126, 0.7152, 0.0722));
    return lerp(l.xxx, c, k);
}

float4 main(float2 uv : TEXCOORD) : COLOR
{
    // центр области и центр карточки совпадают: запас одинаков со всех сторон
    float2 halfSize = Card * 0.5;
    float2 p = uv * Area - Area * 0.5;

    // ---- микрорельеф ------------------------------------------------------
    // Разность двух сэмплов шума даёт строго нулевое среднее: неровность есть,
    // а картинка под стеклом никуда не съезжает. Единицы относительные, иначе
    // текстура ужимается до пикселя и шум превращается в радужные полосы.
    float2 nuv = uv * Area / 96.0 + float2(Phase * 0.013, Phase * 0.009);
    float2 grain = tex2D(noise, nuv).rg - tex2D(noise, nuv + 0.5).rg;

    // Наклон поверхности — только от рельефа. Формы карточки здесь больше нет:
    // именно она и делала край не похожим на всё остальное стекло.
    float2 tilt = grain * (1.6 + Amount * 26.0);

    // Выпуклость под курсором — единственное локальное отступление: мягкий
    // купол, от которого стекло кажется податливым. Радиус в точках.
    float2 tv = (p - Pointer) / 84.0;
    float dome = Touch * exp(-dot(tv, tv) * 1.8);
    tilt += tv * dome * 1.5;

    float3 n = normalize(float3(tilt, 1.0));

    // ---- преломление ------------------------------------------------------
    float3 view = float3(0.0, 0.0, -1.0);
    float depth = 40.0 + Amount * 220.0;             // толщина пластины, точки

    float3 r = refract(view, n, 1.0 / 1.5);
    float2 off = r.xy * (depth / max(0.25, -r.z)) / Area;

    // ---- выборка фона -----------------------------------------------------
    float3 col;
    col.r = tex2D(blurred, saturate(uv + off * (1.0 - DISP))).r;
    col.g = tex2D(blurred, saturate(uv + off)).g;
    col.b = tex2D(blurred, saturate(uv + off * (1.0 + DISP))).b;

    // Стекло чуть поднимает насыщенность — цвет под ним «оживает».
    col = saturateColor(col, 1.18);

    // ---- свет -------------------------------------------------------------
    // Блик от рельефа, одинаковый по всей площади: стекло слегка играет, но
    // никакой подсветки периметра, которая выдавала бы край за отдельную деталь.
    float3 L = normalize(float3(-0.42, -0.78, 0.47));
    float spec = pow(saturate(dot(n, normalize(L - view))), 34.0) * 0.35;
    col += spec;

    // Тонкая нить по самой кромке — контур панели, а не оптика: без неё
    // карточка на пёстром фоне теряет границу. На светлом фоне нить темнеет,
    // белая на белом невидима.
    float d = -sdRoundRect(p, halfSize, Radius);
    float wire = saturate(1.0 - abs(d) / 1.4);
    float lum = dot(col, float3(0.2126, 0.7152, 0.0722));
    col += wire * lerp(0.42, -0.26, smoothstep(0.40, 0.80, lum));

    float a = tex2D(blurred, saturate(uv + off)).a;
    return float4(saturate(col), a);
}
