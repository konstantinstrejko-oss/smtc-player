// Стекло: преломление фона у кромки, лёгкая рябь внутри, дисперсия по краю.
// Вешается ТОЛЬКО на слой фона — под шейдером текст стал бы нечитаем.
// Сборка: fxc /T ps_3_0 /E main /Fo glass.ps glass.fx  (результат коммитится).
//
// Главное правило этого шейдера: внутри карточки картинка должна стоять ровно
// там, где она лежит на экране. Стекло толщиной в пару миллиметров смещает
// изображение только у самой грани; смещение всей картинки читается как дефект
// («фон уехал»), а не как эффект.
// Размеры волны подбирались на стенде с сеткой, поэтому вынесены в макросы:
// fxc /D SCALE_A=... позволяет собрать вариант, не трогая исходник.
#ifndef SCALE_A
#define SCALE_A 110.0     // крупная волна, точек на период текстуры
#endif
#ifndef SCALE_B
#define SCALE_B 40.0      // мелкая зернистость
#endif
#ifndef RIPPLE
#define RIPPLE 380.0      // амплитуда волны: Amount * RIPPLE — размах в точках
#endif

sampler2D src   : register(s0);
sampler2D noise : register(s1);

float  Amount : register(c0);   // сила преломления, 0..0.2
float  Phase  : register(c1);   // медленный дрейф — «жидкость» дышит
float2 Size   : register(c2);   // размер карточки в точках: кромка задаётся в них

float4 main(float2 uv : TEXCOORD) : COLOR
{
    // Разность двух сэмплов шума, разнесённых на полпериода. Одиночный сэмпл
    // нёс постоянную составляющую (у текстуры среднее 140, а не 128), и она
    // сдвигала ВСЮ картинку на несколько точек. У разности среднее строго ноль,
    // какой бы ни была текстура: волна гуляет вокруг исходного места, а не
    // утаскивает картинку в сторону.
    float2 drift = float2(Phase * 0.017, Phase * 0.011);

    // Две октавы. Крупная даёт то самое «толстое стекло», мелкая — зернистость
    // поверхности. Волна на глаз заметна, но каждая линия фона возвращается к
    // своему месту, а не съезжает целиком.
    float2 uvA = uv * Size / SCALE_A + drift;
    float2 uvB = uv * Size / SCALE_B - drift * 1.7;
    float2 nA = tex2D(noise, uvA).rg - tex2D(noise, uvA + 0.5).rg;
    float2 nB = tex2D(noise, uvB).rg - tex2D(noise, uvB + 0.5).rg;

    float2 ripple = (nA * 0.78 + nB * 0.34) * (Amount * RIPPLE);

    // Кромочная линза. Расстояние до ближайшей грани считается по каждой оси
    // отдельно: круговая линза на карточке 440x150 давила бы низ и верх
    // вчетверо сильнее боков.
    float2 px = uv * Size;
    float2 dist = min(px, Size - px);
    float2 t = saturate(1.0 - dist / 18.0);
    t = t * t;                                   // мягкий вход в грань
    float2 dir = sign(Size * 0.5 - px);          // преломляем к центру
    float2 lens = dir * t * (Amount * 150.0);

    // в текстурные координаты
    float2 off = (ripple + lens) / Size;

    // Каналы расходятся только в грани — на однородном фоне середины дисперсия
    // красила бы стекло радужными разводами.
    float2 disp = lens * 0.07 / Size;

    float4 col;
    col.r = tex2D(src, saturate(uv + off + disp)).r;
    col.g = tex2D(src, saturate(uv + off)).g;
    col.b = tex2D(src, saturate(uv + off - disp)).b;
    col.a = tex2D(src, saturate(uv + off)).a;

    // Блика здесь нет намеренно: он считался по разнице соседних сэмплов шума,
    // а билинейная интерполяция делает её ступенчатой — резкая степенная
    // функция превращала ступеньки в рябь по всему стеклу.
    return col;
}
