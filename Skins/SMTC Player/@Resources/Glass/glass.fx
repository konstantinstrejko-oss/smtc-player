// Жидкое стекло: преломление считается от ФОРМЫ карточки, а не от шума.
//
// Идея, из-за которой стекло Apple выглядит настоящим: пластина плоская в
// середине и скруглена по краю. Плоская часть не преломляет ничего — фон под ней
// стоит ровно на месте; вся оптика живёт в фаске шириной в пару десятков точек,
// где поверхность завалена и работает как линза. Шумовое поле такого дать не
// может: оно размазывает искажение по всей площади и читается как рябь на плёнке.
//
// Отсюда устройство шейдера:
//   1. расстояние до края карточки — по SDF скруглённого прямоугольника;
//   2. из него профиль высоты стекла (четверть окружности в фаске, плато внутри);
//   3. нормаль поверхности — численный градиент высоты;
//   4. преломление через refract() с РАЗНЫМ показателем для R, G и B — отсюда
//      дисперсия, честная, а не подмешанная руками;
//   5. в фаске выборка идёт из РЕЗКОГО фона, в середине — из размытого: сквозь
//      сильно сжатую кромку настоящее стекло показывает чёткие полоски;
//   6. блик и френелевская подсветка — из той же нормали, что и преломление.
//
// Сборка: fxc /T ps_3_0 /E main /Fo glass.ps glass.fx  (результат коммитится).

sampler2D blurred : register(s0);   // вход эффекта: фон под размытием
sampler2D noise   : register(s1);   // микрорельеф отливки
sampler2D sharp   : register(s2);   // тот же фон без размытия

float  Amount  : register(c0);   // общая сила преломления, 0..0.2
float  Phase   : register(c1);   // дрейф микрорельефа
float2 Area    : register(c2);   // ВСЯ область эффекта в точках: карточка + запас
float  Radius  : register(c3);   // радиус скругления карточки, точки
float  Bevel   : register(c4);   // ширина фаски, точки
float2 Pointer : register(c5);   // курсор в точках от центра карточки
float  Touch   : register(c6);   // 0..1 — выпуклость под курсором
float2 Card    : register(c7);   // сама карточка в точках

// Область эффекта шире карточки: снимок фона выпущен за её границы, чтобы
// размытию было что размывать. Сузить область нельзя — ни ClipToBounds, ни
// явный Clip на элементе с эффектом её не ограничивают (проверено: шейдер
// продолжает получать координаты вместе с запасом). Поэтому геометрия карточки
// передаётся отдельно, а запас идёт в дело: у кромки линза показывает фон
// ИЗ-ЗА границы окна, сжатый в полоску, — ровно так ведёт себя настоящее стекло.

// Показатель преломления стекла и расхождение по каналам. Дисперсия маленькая
// намеренно: на кромке она видна как тонкая цветная кайма, а больше 0.03 —
// как радуга по всему периметру, что читается дефектом.
static const float IOR  = 1.50;
static const float DISP = 0.018;

/// Знаковое расстояние до края скруглённого прямоугольника: <0 внутри.
float sdRoundRect(float2 p, float2 halfSize, float r)
{
    float2 q = abs(p) - (halfSize - r);
    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}

/// Высота стекла в точке: плато в середине, четверть окружности в фаске.
/// Плюс мягкая выпуклость под курсором — от неё стекло кажется живым.
float heightAt(float2 p, float2 halfCard)
{
    float d = -sdRoundRect(p, halfCard, Radius);      // вглубь карточки, >0
    float s = saturate(d / Bevel);

    // Профиль фаски. Четверть окружности здесь не годится: у самой кромки её
    // производная уходит в бесконечность, нормаль встаёт почти горизонтально, и
    // по периметру идёт резкая ступенька с цветной каймой. Степенной профиль
    // даёт конечный наклон у грани и нулевой на плато — переход к плоской части
    // не виден линией.
    float h = 1.0 - pow(1.0 - s, 2.6);

    // Выпуклость под курсором — купол с мягким краем. Радиус в точках.
    float2 t = (p - Pointer) / 78.0;
    h += Touch * 0.22 * exp(-dot(t, t) * 2.0);

    return h;
}

float3 saturateColor(float3 c, float k)
{
    float l = dot(c, float3(0.2126, 0.7152, 0.0722));
    return lerp(l.xxx, c, k);
}

float4 main(float2 uv : TEXCOORD) : COLOR
{
    // центр области и центр карточки совпадают: запас одинаков со всех сторон
    float2 halfSize = Card * 0.5;
    float2 p = uv * Area - Area * 0.5;

    // ---- геометрия поверхности -------------------------------------------
    // Толщина пластины в точках: чем толще, тем дальше уводит преломление.
    float thickness = Bevel * (0.6 + Amount * 22.0);

    float e = 1.0;                                   // шаг численной производной
    float hx = heightAt(p + float2(e, 0), halfSize) - heightAt(p - float2(e, 0), halfSize);
    float hy = heightAt(p + float2(0, e), halfSize) - heightAt(p - float2(0, e), halfSize);
    float3 n = normalize(float3(-hx * thickness, -hy * thickness, 2.0 * e));

    // Микрорельеф отливки: разность двух сэмплов шума даёт строго нулевое
    // среднее — стекло получает неровность, но картинка под ним не съезжает.
    float2 nuv = uv * Area / 96.0 + float2(Phase * 0.013, Phase * 0.009);
    float2 grain = tex2D(noise, nuv).rg - tex2D(noise, nuv + 0.5).rg;
    n = normalize(n + float3(grain * 0.05, 0.0));

    // ---- преломление ------------------------------------------------------
    // Луч преломляется на верхней грани и идёт через ВСЮ толщу пластины до
    // плоского низа. Считать путь по локальной высоте — ошибка: у самой кромки
    // высота близка к нулю, и преломление обнулялось именно там, где поверхность
    // завалена сильнее всего, то есть эффект пропадал ровно на своём месте.
    float3 view = float3(0.0, 0.0, -1.0);
    float depth = thickness;

    float3 rr = refract(view, n, 1.0 / (IOR - DISP));
    float3 rg = refract(view, n, 1.0 / IOR);
    float3 rb = refract(view, n, 1.0 / (IOR + DISP));

    float2 offR = rr.xy * (depth / max(0.25, -rr.z)) / Area;
    float2 offG = rg.xy * (depth / max(0.25, -rg.z)) / Area;
    float2 offB = rb.xy * (depth / max(0.25, -rb.z)) / Area;

    // ---- выборка фона -----------------------------------------------------
    // У кромки стекло сжимает фон в узкую полосу, и настоящее стекло показывает
    // её резкой; в середине смотреть не на что — там мягкое размытие.
    float d = -sdRoundRect(p, halfSize, Radius);
    float rim = 1.0 - saturate(d / Bevel);
    float crisp = smoothstep(0.12, 0.72, rim);

    float3 col;
    col.r = lerp(tex2D(blurred, saturate(uv + offR)).r, tex2D(sharp, saturate(uv + offR)).r, crisp);
    col.g = lerp(tex2D(blurred, saturate(uv + offG)).g, tex2D(sharp, saturate(uv + offG)).g, crisp);
    col.b = lerp(tex2D(blurred, saturate(uv + offB)).b, tex2D(sharp, saturate(uv + offB)).b, crisp);

    // Стекло чуть поднимает насыщенность — цвет под ним «оживает».
    col = saturateColor(col, 1.0 + 0.22 * (1.0 - rim * 0.5));

    // ---- свет -------------------------------------------------------------
    // Источник сверху-слева, как у окна в комнате.
    float3 L = normalize(float3(-0.42, -0.78, 0.47));
    float3 H = normalize(L - view);
    float spec = pow(saturate(dot(n, H)), 46.0);

    // Слабый контровой блик снизу-справа: без него фаска выглядит нарисованной.
    float3 L2 = normalize(float3(0.55, 0.62, 0.55));
    float spec2 = pow(saturate(dot(n, normalize(L2 - view))), 22.0) * 0.30;

    // Френель: у скользящего взгляда грань светлеет сама по себе.
    float fres = pow(1.0 - saturate(n.z), 3.4) * 0.5;

    col += (spec + spec2 + fres) * rim;

    // Тонкая нить по самой кромке — как у полированного торца. Ширина полторы
    // точки: толще читается нарисованной рамкой, а не бликом. На светлом фоне
    // нить темнеет: белая на белом невидима, и карточка теряет край.
    float wire = saturate(1.0 - abs(d) / 1.6) * saturate(0.35 + dot(normalize(float2(-0.5, -0.85)), normalize(p + 0.001)) * 0.65);
    float lum = dot(col, float3(0.2126, 0.7152, 0.0722));
    col += wire * lerp(0.55, -0.30, smoothstep(0.38, 0.78, lum));

    // Сразу за фаской стекло чуть темнее: так читается его толщина. Без этого
    // грань выглядит наклейкой поверх фона.
    float inner = saturate((d - Bevel) / 14.0) * saturate(1.0 - (d - Bevel) / 26.0);
    col *= 1.0 - inner * 0.10;

    float a = tex2D(blurred, saturate(uv + offG)).a;
    return float4(saturate(col), a);
}
